{
  "name": "exponent-fill",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "Exponent Fill (working name): AI-assisted form filling for Chrome. Proprietary, all rights reserved.",
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev:ext": "pnpm --filter @exponent-fill/extension dev",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @exponent-fill/extension test:e2e",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:invariants": "node scripts/check-invariants.mjs",
    "check:licenses": "node scripts/check-licenses.mjs",
    "backup": "pwsh scripts/backup-code.ps1",
    "spikes:rehearse": "node spikes/runner/rehearse.mjs"
  }
}
